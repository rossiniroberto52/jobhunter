FROM --platform=$BUILDPLATFORM rust:1.85-bookworm AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev libfontconfig1-dev libfreetype6-dev \
    libxcb-render0-dev libxcb-shape0-dev libxcb-xfixes0-dev \
    libxcb-xkb-dev libxkbcommon-dev libxkbcommon-x11-dev \
    libwayland-dev libxkbregistry-dev libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETPLATFORM
ARG BUILDPLATFORM

# Cache de dependências
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --target x86_64-unknown-linux-gnu && rm -rf src

# Build real
COPY src ./src
COPY config.toml ./
RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    touch src/main.rs && cargo build --release --target x86_64-unknown-linux-gnu

# ---------- Runtime ----------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libfontconfig1 libfreetype6 libxcb-render0 libxcb-shape0 \
    libxcb-xfixes0 libxcb-xkb0 libxkbcommon0 libxkbcommon-x11-0 \
    libgtk-3-0 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/x86_64-unknown-linux-gnu/release/jobhunter /app/jobhunter
COPY config.toml /app/config.toml

RUN mkdir -p /data && chmod 777 /data

ENTRYPOINT ["/app/jobhunter"]
CMD ["gui"]
